{
  "name": "jinghe-license-tool",
  "version": "1.0.0",
  "description": "镜核授权签发工具",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "package": "electron-builder --win nsis",
    "package:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jinghe.license-tool",
    "productName": "镜核授权签发工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "signer.js",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
